{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${mod_license}",
  "contact": {
    "homepage": "https://github.com/Blazelow/Dawn-of-Time-Extra-Additions",
    "sources": "https://github.com/Blazelow/Dawn-of-Time-Extra-Additions",
    "issues": "https://github.com/Blazelow/Dawn-of-Time-Extra-Additions/issues"
  },
  "environment": "*",
  "icon": "icon.png",
  "accessWidener": "dawnoftimeextras.accesswidener",
  "mixins": [
    "dawnoftimeextras.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.blazelow.dawnoftimeextras.DawnOfTimeExtrasFabric"
    ],
    "client": [
      "com.blazelow.dawnoftimeextras.DawnOfTimeExtrasClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "1.20.1",
